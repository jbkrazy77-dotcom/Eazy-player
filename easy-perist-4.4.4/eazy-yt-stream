        [ -z "$q" ] && continue
        AUDIO_ONLY=0 DOWNLOAD=0
        search_and_play "$q" || true
        ;;
      audio)
        local u
        u=$(whiptail --title "Adulto 18+ — só áudio" --inputbox "URL:" 10 72 "https://" 3>&1 1>&2 2>&3) || continue
        [ -z "$u" ] || [[ "$u" == "https://" ]] && continue
