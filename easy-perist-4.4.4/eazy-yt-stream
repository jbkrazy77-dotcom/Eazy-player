#!/usr/bin/env bash
# eazy-yt-stream — streaming YouTube (yt-dlp + mpv/mplayer), script separado
# Otimizado para WSL2
#
# Uso:
#   ./eazy-yt-stream                         # menu
#   ./eazy-yt-stream "https://youtube.com/..."
#   ./eazy-yt-stream -s "lofi hip hop"
#   ./eazy-yt-stream -a "URL"
#   ./eazy-yt-stream -q 480 "URL"
#   ./eazy-yt-stream --download "URL"
#
set -euo pipefail

RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[1;33m'
CYAN=$'\033[0;36m'
NC=$'\033[0m'

PLAYER="${EAZY_YT_PLAYER:-mpv}"
YTDLP="${EAZY_YTDLP:-yt-dlp}"
OUT_DIR="${EAZY_YT_OUT:-$HOME/Downloads}"
DATA_DIR="${EAZY_YT_DATA:-$HOME/.config/eazy-yt-stream}"
SEARCH_INDEX="$DATA_DIR/searches.tsv"
FAVORITES_FILE="$DATA_DIR/favorites.tsv"
TV_FAVORITES_FILE="$DATA_DIR/tv_favorites.tsv"
YTDLP_AUTH_ARGS=()
if [ -n "${EAZY_YT_COOKIES:-}" ]; then
  YTDLP_AUTH_ARGS+=(--cookies "$EAZY_YT_COOKIES")
elif [ -n "${EAZY_YT_BROWSER_COOKIES:-}" ]; then
  YTDLP_AUTH_ARGS+=(--cookies-from-browser "$EAZY_YT_BROWSER_COOKIES")
fi

ytdlp() { "$YTDLP" "${YTDLP_AUTH_ARGS[@]}" "$@"; }
# Cache do MPlayer em KiB; pode ser ajustado sem editar o script.
# 64 MiB/30% reduz esvaziamentos em streams HTTP com bitrate variável.
MPLAYER_CACHE="${EAZY_MPLAYER_CACHE:-65536}"
MPLAYER_CACHE_MIN="${EAZY_MPLAYER_CACHE_MIN:-30}"
TEST_URL="https://www.tokyvideo.com/br/video/matrix-1999-cineplus"
QUALITY=""
AUDIO_ONLY=0
DOWNLOAD=0
SEARCH=0

usage() {
  cat <<'U'
eazy-yt-stream — stream YouTube com yt-dlp + mpv/mplayer

  ./eazy-yt-stream                  # menu interativo
  ./eazy-yt-stream URL
  ./eazy-yt-stream -s "termo"
  ./eazy-yt-stream -a URL           # só áudio
  ./eazy-yt-stream -q 480 URL       # limitar resolução
  ./eazy-yt-stream --download URL   # gravar em ~/Downloads e tocar
  ./eazy-yt-stream --test           # testar com um vídeo TokyVideo
  ./eazy-yt-stream --tv             # menu TV Aberta (lives/canais)
  ./eazy-yt-stream --adulto         # menu Adulto 18+

Variáveis:
  EAZY_YT_PLAYER=mpv|mplayer|ffplay|cvlc
  EAZY_YT_VO=x11|gl|null (WSL: evita XV/BadMatch)
  EAZY_YT_OUT=~/Downloads
  EAZY_YTDLP=yt-dlp
  EAZY_MPLAYER_CACHE=65536          # cache do MPlayer em KiB
  EAZY_MPLAYER_CACHE_MIN=30         # percentual antes de iniciar
  EAZY_YT_SEARCH_COUNT=10           # resultados exibidos para escolher
  EAZY_YT_DATA=~/.config/eazy-yt-stream  # histórico e favoritos
  EAZY_YT_COOKIES=~/youtube-cookies.txt # cookies exportados do navegador
  EAZY_YT_BROWSER_COOKIES=chrome        # alternativa: chrome, firefox, edge
U
}

need() {
  local bin="$1" pkg="${2:-$1}"
  if ! command -v "$bin" >/dev/null 2>&1; then
    printf '%s\n' "${RED}Comando não encontrado: $bin${NC}"
    printf '%s\n' "Instale: sudo apt-get install -y $pkg"
    exit 1
  fi
}

eazy_is_wsl() {
  [ -n "${WSL_DISTRO_NAME:-}" ] && return 0
  [ -n "${WSL_INTEROP:-}" ] && return 0
  grep -qiE 'microsoft|wsl' /proc/version 2>/dev/null && return 0
  return 1
}

eazy_wsl_setup() {
  eazy_is_wsl || return 0
  export EAZY_WSL=1
  if [ -z "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ]; then
    if [ -e /mnt/wslg/runtime-dir ]; then
      export DISPLAY="${DISPLAY:-:0}"
      export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
      export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/mnt/wslg/runtime-dir}"
    else
      export DISPLAY="${DISPLAY:-:0}"
    fi
  fi
}

choose_fmt() {
  if [ "$AUDIO_ONLY" -eq 1 ]; then
    echo "bestaudio/best"
    return
  fi
  case "$PLAYER" in
    mplayer)
      # progressivo (1 URL) primeiro; senão DASH (2 URLs → -audiofile)
      if [ -n "$QUALITY" ]; then
        echo "18/22/best[height<=${QUALITY}]/bestvideo[height<=${QUALITY}]+bestaudio/best"
      else
        echo "18/22/best[height<=480]/bestvideo[height<=720]+bestaudio/best"
      fi
      ;;
    *)
      if [ -n "$QUALITY" ]; then
        echo "bestvideo[height<=${QUALITY}]+bestaudio/best[height<=${QUALITY}]/best"
      else
        echo "bestvideo[height<=720]+bestaudio/best[height<=720]/best"
      fi
      ;;
  esac
}

play_mplayer() {
  local target="$1" fmt="$2"
  local -a urls=()
  local url vurl aurl
  local -a vo=()
  local -a cache_args=(-cache "$MPLAYER_CACHE" -cache-min "$MPLAYER_CACHE_MIN")

  if eazy_is_wsl; then
    vo=(-vo "${EAZY_YT_VO:-x11,gl,null}")
  elif [ -n "${EAZY_YT_VO:-}" ]; then
    vo=(-vo "$EAZY_YT_VO")
  fi

  mapfile -t urls < <(ytdlp -f "$fmt" -g --no-playlist "$target" 2>/dev/null || true)
  if [ "${#urls[@]}" -eq 0 ]; then
    mapfile -t urls < <(ytdlp -f "18/22/best" -g --no-playlist "$target" 2>/dev/null || true)
  fi
  if [ "${#urls[@]}" -eq 0 ]; then
    printf '%s\n' "${RED}Não obteve URL de stream${NC}"
    return 1
  fi

  if [ "$AUDIO_ONLY" -eq 1 ]; then
    url="${urls[-1]}"
    printf '%s\n' "${GREEN}▶ mplayer só áudio${NC}"
    mplayer "${cache_args[@]}" -novideo -- "$url" || true
    return 0
  fi

  if [ "${#urls[@]}" -ge 2 ]; then
    vurl="${urls[0]}"
    aurl="${urls[-1]}"
    printf '%s\n' "${CYAN}  DASH: vídeo + áudio (2 URLs)${NC}"
    # -audiofile funciona com http em mplayer recente
    if mplayer "${cache_args[@]}" -audiofile "$aurl" "${vo[@]}" -- "$vurl"; then
      return 0
    fi
    printf '%s\n' "${YELLOW}  fallback: só vídeo (sem áudio separado)${NC}"
    mplayer "${cache_args[@]}" "${vo[@]}" -- "$vurl" || true
    return 0
  fi

  url="${urls[0]}"
  printf '%s\n' "${CYAN}  stream progressivo (1 URL)${NC}"
  mplayer "${cache_args[@]}" "${vo[@]}" -- "$url" || true
}

play_stream() {
  local target="$1"
  local title fmt

  eazy_wsl_setup
  need "$YTDLP" "yt-dlp"
  need "$PLAYER" "$PLAYER"

  printf '%s\n' "${CYAN}A obter título...${NC}"
  title=$(ytdlp --get-title --no-playlist "$target" 2>/dev/null | head -n1 || echo "YouTube")
  printf '%s\n' "${GREEN}▶ ${title}${NC}"

  fmt=$(choose_fmt)

  if [ "$DOWNLOAD" -eq 1 ]; then
    mkdir -p "$OUT_DIR"
    printf '%s\n' "${YELLOW}▶ download → $OUT_DIR${NC}"
    local out_tpl="$OUT_DIR/%(title).80B [%(id)s].%(ext)s"
    # merge para ficheiro completo
    ytdlp -f "bestvideo[height<=720]+bestaudio/best" --merge-output-format mp4 \
      -o "$out_tpl" --no-playlist "$target" || \
    ytdlp -f "18/22/best" -o "$out_tpl" --no-playlist "$target"
    local last
    last=$(find "$OUT_DIR" -type f \( -iname '*.mp4' -o -iname '*.webm' -o -iname '*.mkv' -o -iname '*.m4a' -o -iname '*.opus' \) -printf '%T@ %p\n' 2>/dev/null | sort -nr | head -n1 | cut -d' ' -f2-)
    if [ -n "$last" ] && [ -f "$last" ]; then
      printf '%s\n' "${GREEN}✓ $last${NC}"
      "$PLAYER" -- "$last" || true
    fi
    return 0
  fi

  printf '%s\n' "${GREEN}▶ stream (sem gravar) player=$PLAYER fmt=$fmt${NC}"

  case "$PLAYER" in
    mplayer)
      play_mplayer "$target" "$fmt"
      ;;
    mpv)
      local -a vo_args=(--vo=x11 --cache=yes --ao=pulse --framedrop=vo)
      local -a mpv_args=(--ytdl --ytdl-format="$fmt")
      if [ -n "${EAZY_YT_COOKIES:-}" ]; then
        mpv_args+=(--ytdl-raw-options="cookies=$EAZY_YT_COOKIES")
      elif [ -n "${EAZY_YT_BROWSER_COOKIES:-}" ]; then
        mpv_args+=(--ytdl-raw-options="cookies-from-browser=$EAZY_YT_BROWSER_COOKIES")
      fi
      [ "$AUDIO_ONLY" -eq 1 ] && mpv_args+=(--vid=no)
      mpv "${mpv_args[@]}" "${vo_args[@]}" -- "$target" || true
      ;;
    ffplay)
      local url
      mapfile -t _u < <(ytdlp -f "$fmt" -g --no-playlist "$target" 2>/dev/null)
      url="${_u[0]:-}"
      [ -n "$url" ] || { printf '%s\n' "${RED}Sem URL${NC}"; return 1; }
      ffplay -autoexit -loglevel warning -i "$url" || true
      ;;
    cvlc|vlc)
      local url
      mapfile -t _u < <(ytdlp -f "$fmt" -g --no-playlist "$target" 2>/dev/null)
      url="${_u[0]:-}"
      [ -n "$url" ] || { printf '%s\n' "${RED}Sem URL${NC}"; return 1; }
      cvlc --play-and-exit "$url" || true
      ;;
    *)
      printf '%s\n' "${RED}Player não suportado: $PLAYER${NC}"
      return 1
      ;;
  esac
}

search_id() {
  printf '%s' "$1" | sha256sum | awk '{print substr($1,1,16)}'
}

save_search() {
  local query="$1" file="$2" id
  id=$(search_id "$query")
  mkdir -p "$DATA_DIR/searches"
  cp -- "$file" "$DATA_DIR/searches/$id.tsv"
  touch "$SEARCH_INDEX"
  grep -Fqx -- "$id|$query" "$SEARCH_INDEX" 2>/dev/null || printf '%s|%s\n' "$id" "$query" >> "$SEARCH_INDEX"
}

save_favorite() {
  local id="$1" title="$2" url="$3"
  mkdir -p "$DATA_DIR"
  touch "$FAVORITES_FILE"
  grep -Fq -- "$id|" "$FAVORITES_FILE" 2>/dev/null || printf '%s|%s|%s\n' "$id" "$title" "$url" >> "$FAVORITES_FILE"
  printf '%s\n' "${GREEN}✓ Favorito salvo${NC}"
}

choose_saved_result() {
  local query="$1" file="$2" selected index id title url
  local -a ids=() titles=() menu=()
  [ -s "$file" ] || { printf '%s\n' "${RED}Nenhum resultado salvo.${NC}"; return 1; }
  while IFS='|' read -r id title; do
    [ -n "$id" ] || continue
    ids+=("$id"); titles+=("$title"); menu+=("${#ids[@]}" "$title")
  done < "$file"
  [ "${#ids[@]}" -gt 0 ] || return 1
  if command -v whiptail >/dev/null 2>&1 && [ -t 0 ]; then
    selected=$(whiptail --title "Resultados: $query" --menu "Escolha um vídeo:" 22 100 12 "${menu[@]}" 3>&1 1>&2 2>&3) || return 0
  else
    printf '%s\n' "${YELLOW}Resultados: $query${NC}"
    for index in "${!ids[@]}"; do printf ' %2d) %s\n' "$((index+1))" "${titles[$index]}"; done
    printf '%s' "Escolha: "; read -r selected || return 0
  fi
  [[ "$selected" =~ ^[0-9]+$ ]] && [ "$selected" -ge 1 ] && [ "$selected" -le "${#ids[@]}" ] || return 1
  index=$((selected-1)); id="${ids[$index]}"; title="${titles[$index]}"; url="https://www.youtube.com/watch?v=$id"
  if command -v whiptail >/dev/null 2>&1 && [ -t 0 ]; then
    whiptail --title "Favorito" --yesno "Marcar como favorito?\n\n$title" 10 80 && save_favorite "$id" "$title" "$url" || true
  fi
  play_stream "$url"
}

choose_saved_search() {
  local selected index id query
  local -a ids=() queries=() menu=()
  [ -s "$SEARCH_INDEX" ] || { printf '%s\n' "${YELLOW}Nenhuma pesquisa salva.${NC}"; return 1; }
  while IFS='|' read -r id query; do
    [ -n "$id" ] || continue
    ids+=("$id"); queries+=("$query"); menu+=("${#ids[@]}" "$query")
  done < "$SEARCH_INDEX"
  if command -v whiptail >/dev/null 2>&1 && [ -t 0 ]; then
    selected=$(whiptail --title "Pesquisas salvas" --menu "Escolha uma pesquisa:" 20 90 12 "${menu[@]}" 3>&1 1>&2 2>&3) || return 0
  else
    for index in "${!queries[@]}"; do printf ' %2d) %s\n' "$((index+1))" "${queries[$index]}"; done
    printf '%s' "Escolha: "; read -r selected || return 0
  fi
  [[ "$selected" =~ ^[0-9]+$ ]] && [ "$selected" -ge 1 ] && [ "$selected" -le "${#ids[@]}" ] || return 1
  index=$((selected-1)); choose_saved_result "${queries[$index]}" "$DATA_DIR/searches/${ids[$index]}.tsv"
}

choose_favorite() {
  [ -s "$FAVORITES_FILE" ] || { printf '%s\n' "${YELLOW}Nenhum favorito salvo.${NC}"; return 1; }
  choose_saved_result "Favoritos" "$FAVORITES_FILE"
}

search_and_play() {
  local query="$1"
  local count="${EAZY_YT_SEARCH_COUNT:-10}"
  local line id title selected index target
  local -a results=() menu=() ids=()

  need "$YTDLP" "yt-dlp"
  printf '%s\n' "${CYAN}A pesquisar: $query${NC}"

  mapfile -t results < <(ytdlp --flat-playlist --playlist-end "$count" \
    --no-warnings --print '%(id)s|%(title)s' "ytsearch${count}:${query}" 2>/dev/null || true)

  if [ "${#results[@]}" -eq 0 ]; then
    printf '%s\n' "${RED}Nenhum vídeo encontrado.${NC}"
    return 1
  fi

  for line in "${results[@]}"; do
    id="${line%%|*}"
    title="${line#*|}"
    [ -n "$id" ] || continue
    ids+=("$id")
    menu+=("${#ids[@]}" "$title")
  done

  if [ "${#ids[@]}" -eq 0 ]; then
    printf '%s\n' "${RED}Nenhum resultado válido.${NC}"
    return 1
  fi

  local saved_results
  saved_results=$(mktemp)
  printf '%s\n' "${results[@]}" > "$saved_results"
  save_search "$query" "$saved_results"
  rm -f -- "$saved_results"

  printf '%s\n' "${YELLOW}Resultados encontrados:${NC}"
  for index in "${!ids[@]}"; do
    printf ' %2d) %s\n' "$((index + 1))" "${results[$index]#*|}"
  done

  if command -v whiptail >/dev/null 2>&1 && [ -t 0 ]; then
    selected=$(whiptail --title "Resultados: $query" \
      --menu "Escolha um vídeo (Enter confirma):" 22 100 12 \
      "${menu[@]}" 3>&1 1>&2 2>&3) || return 0
    index="$selected"
  else
    printf '%s' "Escolha [1-${#ids[@]}] (0 cancela): "
    read -r index || return 0
    [ "$index" != "0" ] || return 0
  fi

  if ! [[ "$index" =~ ^[0-9]+$ ]] || [ "$index" -lt 1 ] || [ "$index" -gt "${#ids[@]}" ]; then
    printf '%s\n' "${RED}Opção inválida.${NC}"
    return 1
  fi

  target="https://www.youtube.com/watch?v=${ids[$((index - 1))]}"
  play_stream "$target"
}


# --- TV Aberta: atalhos para lives/canais oficiais no YouTube ---
# Nota: Globo/SBT/Record oficiais usam apps com DRM; aqui vão fontes
# públicas/YouTube que o yt-dlp costuma abrir (TV pública, notícias, esporte).
play_channel_live() {
  local handle="$1" label="${2:-$1}"
  local url="https://www.youtube.com/${handle}/live"
  local ok=0
  printf '%s\n' "${CYAN}▶ TV Aberta: $label${NC}"
  printf '%s\n' "${YELLOW}  $url${NC}"
  if ytdlp --get-title --no-playlist "$url" >/dev/null 2>&1; then
    AUDIO_ONLY=0 DOWNLOAD=0
    play_stream "$url" || true
    ok=1
  fi
  if [ "$ok" -eq 0 ]; then
    printf '%s\n' "${YELLOW}Sem live em /live — a pesquisar: ${label} ao vivo${NC}"
    AUDIO_ONLY=0 DOWNLOAD=0
    search_and_play "${label} ao vivo" || true
  fi
  # Oferece marcar canal como favorito da TV Aberta
  if command -v whiptail >/dev/null 2>&1 && [ -t 0 ]; then
    if whiptail --title "Favorito TV Aberta" --yesno \
"Marcar este canal como favorito?\n\n$label\n$handle" 11 60; then
      save_tv_favorite "$handle" "$label" "$url"
    fi
  fi
}

save_tv_favorite() {
  local handle="$1" label="$2" url="$3"
  mkdir -p "$DATA_DIR"
  touch "$TV_FAVORITES_FILE"
  # evita duplicar pelo handle
  if grep -Fq -- "${handle}|" "$TV_FAVORITES_FILE" 2>/dev/null; then
    printf '%s\n' "${YELLOW}Já está nos favoritos: $label${NC}"
    return 0
  fi
  printf '%s|%s|%s\n' "$handle" "$label" "$url" >> "$TV_FAVORITES_FILE"
  printf '%s\n' "${GREEN}✓ Canal favorito: $label${NC}"
}

remove_tv_favorite() {
  local handle="$1"
  [ -s "$TV_FAVORITES_FILE" ] || return 0
  grep -Fv -- "${handle}|" "$TV_FAVORITES_FILE" > "${TV_FAVORITES_FILE}.tmp" 2>/dev/null \
    && mv -f "${TV_FAVORITES_FILE}.tmp" "$TV_FAVORITES_FILE" || true
}

choose_tv_favorite() {
  local selected index handle label url
  local -a handles=() labels=() urls=() menu=()
  [ -s "$TV_FAVORITES_FILE" ] || {
    whiptail --title "Favoritos TV Aberta" --msgbox \
"Nenhum canal favorito ainda.

Abre um canal e responde Sim em
«Marcar como favorito», ou usa
«Adicionar aos favoritos»." 12 55
    return 1
  }
  while IFS='|' read -r handle label url; do
    [ -n "$handle" ] || continue
    handles+=("$handle"); labels+=("$label"); urls+=("$url")
    menu+=("${#handles[@]}" "$label  ($handle)")
  done < "$TV_FAVORITES_FILE"
  [ "${#handles[@]}" -gt 0 ] || return 1
  selected=$(whiptail --title "Favoritos TV Aberta" --menu \
"Escolha o canal:" 20 72 12 "${menu[@]}" 3>&1 1>&2 2>&3) || return 0
  [[ "$selected" =~ ^[0-9]+$ ]] || return 1
  index=$((selected - 1))
  handle="${handles[$index]}"; label="${labels[$index]}"
  local acao
  acao=$(whiptail --title "$label" --menu "O que fazer?" 12 50 3 \
    "play" "▶ Tocar / live" \
    "del"  "🗑 Remover dos favoritos" \
    "voltar" "Cancelar" \
    3>&1 1>&2 2>&3) || return 0
  case "$acao" in
    play) play_channel_live "$handle" "$label" ;;
    del)
      remove_tv_favorite "$handle"
      whiptail --title "Favoritos" --msgbox "Removido: $label" 8 40
      ;;
  esac
}

add_tv_favorite_dialog() {
  local op handle label
  op=$(whiptail --title "Adicionar favorito TV Aberta" --menu \
"Escolha o canal para favoritar:" 20 70 11 \
    "tvbrasil"   "TV Brasil" \
    "cultura"    "TV Cultura" \
    "camara"     "TV Câmara" \
    "senado"     "TV Senado" \
    "cnn"        "CNN Brasil" \
    "jovempan"   "Jovem Pan News" \
    "cazetv"     "CazéTV" \
    "recordnews" "Record News" \
    "outro"      "Outro (@handle manual)" \
    3>&1 1>&2 2>&3) || return 0
  case "$op" in
    tvbrasil)   handle="@tvbrasil"; label="TV Brasil" ;;
    cultura)    handle="@tvcultura"; label="TV Cultura" ;;
    camara)     handle="@camara"; label="TV Câmara" ;;
    senado)     handle="@TVSenado"; label="TV Senado" ;;
    cnn)        handle="@cnnbrasil"; label="CNN Brasil" ;;
    jovempan)   handle="@JovemPanNews"; label="Jovem Pan News" ;;
    cazetv)     handle="@CazeTV"; label="CazéTV" ;;
    recordnews) handle="@recordnews"; label="Record News" ;;
    outro)
      handle=$(whiptail --title "Handle YouTube" --inputbox \
"Handle do canal (ex.: @tvbrasil):" 10 60 "@" 3>&1 1>&2 2>&3) || return 0
      [ -z "$handle" ] && return 0
      case "$handle" in @*) ;; *) handle="@$handle" ;; esac
      label=$(whiptail --title "Nome" --inputbox "Nome para a lista:" 10 60 "$handle" 3>&1 1>&2 2>&3) || return 0
      [ -z "$label" ] && label="$handle"
      ;;
    *) return 0 ;;
  esac
  save_tv_favorite "$handle" "$label" "https://www.youtube.com/${handle}/live"
  whiptail --title "Favoritos" --msgbox "Salvo:\n$label\n$handle" 9 45
}

menu_tv_aberta() {
  need "$YTDLP" "yt-dlp"
  need "$PLAYER" "$PLAYER"
  while true; do
    local op n_fav
    n_fav=0
    [ -s "${TV_FAVORITES_FILE:-}" ] && n_fav=$(grep -cve '^[[:space:]]*$' "$TV_FAVORITES_FILE" 2>/dev/null || echo 0)
    n_fav=$(printf '%s' "$n_fav" | tr -cd '0-9'); n_fav=${n_fav:-0}
    op=$(whiptail --title "TV Aberta — lives / canais" --menu \
"Fontes públicas e oficiais no YouTube (yt-dlp).
Globo/SBT/Record completos: use os apps (DRM).
Player: $PLAYER | Favoritos: $n_fav" 22 74 14 \
      "favs"       "★ Meus canais favoritos ($n_fav)" \
      "addfav"     "＋ Adicionar canal aos favoritos" \
      "tvbrasil"   "TV Brasil (EBC) — live" \
      "cultura"    "TV Cultura — live / ao vivo" \
      "camara"     "TV Câmara — live" \
      "senado"     "TV Senado — live" \
      "cnn"        "CNN Brasil — live" \
      "jovempan"   "Jovem Pan News — live" \
      "cazetv"     "CazéTV (esporte) — live" \
      "getv"       "GE TV (esporte) — pesquisar" \
      "recordnews" "Record News — live" \
      "sbtnews"    "SBT News — pesquisar" \
      "busca"      "Pesquisar canal / ao vivo..." \
      "voltar"     "Voltar" \
      3>&1 1>&2 2>&3) || return 0
    case "$op" in
      favs)       choose_tv_favorite || true ;;
      addfav)     add_tv_favorite_dialog || true ;;
      tvbrasil)   play_channel_live "@tvbrasil" "TV Brasil" ;;
      cultura)    play_channel_live "@tvcultura" "TV Cultura" ;;
      camara)     play_channel_live "@camara" "TV Câmara" ;;
      senado)     play_channel_live "@TVSenado" "TV Senado" ;;
      cnn)        play_channel_live "@cnnbrasil" "CNN Brasil" ;;
      jovempan)   play_channel_live "@JovemPanNews" "Jovem Pan News" ;;
      cazetv)     play_channel_live "@CazeTV" "CazéTV" ;;
      getv)
        AUDIO_ONLY=0 DOWNLOAD=0
        search_and_play "GE TV ao vivo" || true
        ;;
      recordnews) play_channel_live "@recordnews" "Record News" ;;
      sbtnews)
        AUDIO_ONLY=0 DOWNLOAD=0
        search_and_play "SBT News ao vivo" || true
        ;;
      busca)
        local q
        q=$(whiptail --title "TV Aberta — pesquisar" --inputbox \
          "Termo (ex.: Band ao vivo, Globo jornal):" 10 70 3>&1 1>&2 2>&3) || continue
        [ -z "$q" ] && continue
        AUDIO_ONLY=0 DOWNLOAD=0
        search_and_play "$q" || true
        ;;
      voltar|*) return 0 ;;
    esac
  done
}


# --- Adulto 18+ ---
menu_adulto() {
