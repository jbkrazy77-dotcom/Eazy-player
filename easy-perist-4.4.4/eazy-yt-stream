# --- parse ---
ARGS=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --test) ARGS+=("$TEST_URL"); shift ;;
    --tv|--tv-aberta)
      eazy_wsl_setup
      need "$YTDLP" "yt-dlp"
      need "$PLAYER" "$PLAYER"
      need whiptail "whiptail"
      menu_tv_aberta
      exit 0
      ;;
    --adulto|--adult|--18)
      eazy_wsl_setup
      need "$YTDLP" "yt-dlp"
      need "$PLAYER" "$PLAYER"
      need whiptail "whiptail"
      menu_adulto
      exit 0
      ;;
    -s|--search) SEARCH=1; shift ;;
    -a|--audio) AUDIO_ONLY=1; shift ;;
    -q|--quality) QUALITY="${2:-}"; shift 2 ;;
    --download|-d) DOWNLOAD=1; shift ;;
    --)
      shift
      while [ "$#" -gt 0 ]; do ARGS+=("$1"); shift; done
      break
      ;;
    -*)
      printf '%s\n' "${RED}Opção desconhecida: $1${NC}"
      usage
      exit 1
      ;;
    *) ARGS+=("$1"); shift ;;
  esac
done

eazy_wsl_setup

# menu se sem args
if [ "${#ARGS[@]}" -eq 0 ] && [ -t 0 ]; then
  need "$YTDLP" "yt-dlp"
  need whiptail "whiptail"
  while true; do
    op=$(whiptail --title "eazy-yt-stream — YouTube" --menu \
      "Player: $PLAYER | Qualidade: ${QUALITY:-auto}\nEscolha:" 21 74 12 \
      "1" "Stream por URL" \
      "2" "Pesquisar e stream" \
      "3" "So audio por URL" \
      "4" "Pesquisar so audio" \
      "5" "Download + tocar" \
      "6" "Qualidade (atual: ${QUALITY:-auto})" \
      "7" "Trocar player (atual: $PLAYER)" \
      "8" "Pesquisas salvas" \
      "9" "Favoritos" \
      "T" "TV Aberta — lives / canais" \
      "A" "Adulto 18+" \
      "0" "Sair" \
      3>&1 1>&2 2>&3) || exit 0
    case "$op" in
      1)
        url=$(whiptail --title "Stream URL" --inputbox "URL YouTube:" 10 70 3>&1 1>&2 2>&3) || continue
        [ -z "$url" ] && continue
        AUDIO_ONLY=0 DOWNLOAD=0
        play_stream "$url" || true
        ;;
      2)
        q=$(whiptail --title "Pesquisar" --inputbox "Termo:" 10 70 3>&1 1>&2 2>&3) || continue
        [ -z "$q" ] && continue
        AUDIO_ONLY=0 DOWNLOAD=0
        search_and_play "$q" || true
        ;;
      3)
        url=$(whiptail --title "So audio" --inputbox "URL YouTube:" 10 70 3>&1 1>&2 2>&3) || continue
        [ -z "$url" ] && continue
        AUDIO_ONLY=1 DOWNLOAD=0
        play_stream "$url" || true
        ;;
      4)
        q=$(whiptail --title "Pesquisar so audio" --inputbox "Termo:" 10 70 3>&1 1>&2 2>&3) || continue
        [ -z "$q" ] && continue
        AUDIO_ONLY=1 DOWNLOAD=0
        search_and_play "$q" || true
        ;;
      5)
        url=$(whiptail --title "Download" --inputbox "URL YouTube:" 10 70 3>&1 1>&2 2>&3) || continue
        [ -z "$url" ] && continue
        DOWNLOAD=1
        play_stream "$url" || true
        DOWNLOAD=0
        ;;
      6)
        q=$(whiptail --title "Qualidade" --menu "Max:" 14 50 5 \
          "" "Auto" "360" "360p" "480" "480p" "720" "720p" "1080" "1080p" \
          3>&1 1>&2 2>&3) || continue
        QUALITY="$q"
        ;;
      7)
        p=$(whiptail --title "Player" --menu "Player:" 14 50 4 \
          "mpv" "mpv (padrao)" \
          "mplayer" "MPlayer" \
          "ffplay" "FFplay" \
          "cvlc" "VLC CLI" \
          3>&1 1>&2 2>&3) || continue
        PLAYER="$p"
        ;;
      8)
        choose_saved_search || true
        ;;
      9)
        choose_favorite || true
        ;;
      T|t)
        menu_tv_aberta || true
        ;;
      A|a)
        menu_adulto || true
        ;;
      0) exit 0 ;;
    esac
  done
fi

# CLI
TARGET="${ARGS[0]:-}"
[ -n "$TARGET" ] || { usage; exit 1; }
if [ "$SEARCH" -eq 1 ] || [[ ! "$TARGET" =~ ^https?:// && ! "$TARGET" =~ ^ytsearch ]]; then
  search_and_play "$TARGET"
else
  play_stream "$TARGET"
fi
