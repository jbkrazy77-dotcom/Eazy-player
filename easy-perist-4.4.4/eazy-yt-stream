        [ -z "$u" ] || [[ "$u" == "https://" ]] && continue
        DOWNLOAD=1 AUDIO_ONLY=0
        play_stream "$u" || true
        DOWNLOAD=0
        ;;
      ph|xv|xn)
        local tip u
        case "$op" in
          ph) tip="Pornhub" ;;
          xv) tip="XVideos" ;;
          xn) tip="XNXX" ;;
        esac
        u=$(whiptail --title "Adulto 18+ — $tip" --inputbox \
